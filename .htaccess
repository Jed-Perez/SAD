Options -Indexes
# Block hidden project files and directories, including repository metadata.
RedirectMatch 404 "(^|/)\."
<FilesMatch "^(config.*\.php|install\.php|.*\.sql|.*\.md)$">
    Require all denied
</FilesMatch>
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
</IfModule>
